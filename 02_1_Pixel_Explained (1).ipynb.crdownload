      },
      "text/plain": [
       "FileUpload(value=(), accept='image/*', description='Upload image')"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "uploader = widgets.FileUpload(accept='image/*', multiple=False, description='Upload image')\n",
    "display(uploader)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f6a7b8c9",
   "metadata": {},
   "source": [
    "---\n",
    "## 2 — Load & inspect the image array\n",
    "\n",
    "After uploading, run this cell to convert it into a NumPy array and peek at its structure."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "a7b8c9d0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Filename   : h3_frame_ref_1.png\n",
      "Original   : 1368 × 768 px  |  mode: RGB\n",
      "Array shape: (768, 1368, 4)  → (height, width, channels)\n",
      "Dtype      : uint8\n",
      "Total pixels: 1,050,624\n",
      "\n",
      "Centre pixel [384, 684]:\n",
      "  R = 146  G = 16  B = 12  A = 255\n",
      "  Hex: #92100C\n"
     ]
    }
   ],
   "source": [
    "# --- load from uploader (ipywidgets 8.x compatible) ---\n",
    "if not uploader.value:\n",
    "    raise ValueError('Please upload an image first (cell above).')\n",
    "\n",
    "file_info = uploader.value[0]  # tuple, not dict\n",
    "img_pil = Image.open(io.BytesIO(file_info['content']))\n",
    "\n",
    "# Ensure RGBA so alpha is always present\n",
    "img_rgba = img_pil.convert('RGBA')\n",
    "img_rgb  = img_pil.convert('RGB')\n",
    "\n",
    "arr  = np.array(img_rgba)\n",
    "arr3 = np.array(img_rgb)\n",
    "\n",
    "H, W = arr.shape[:2]\n",
    "\n",
    "print(f'Filename   : {file_info[\"name\"]}')          # was file_info['metadata']['name']\n",
    "print(f'Original   : {img_pil.size[0]} × {img_pil.size[1]} px  |  mode: {img_pil.mode}')\n",
    "print(f'Array shape: {arr.shape}  → (height, width, channels)')\n",
    "print(f'Dtype      : {arr.dtype}')\n",
    "print(f'Total pixels: {H * W:,}')\n",
    "\n",
    "py, px = H // 2, W // 2\n",
    "r, g, b, a = arr[py, px]\n",
    "print(f'\\nCentre pixel [{py}, {px}]:')\n",
    "print(f'  R = {r}  G = {g}  B = {b}  A = {a}')\n",
    "print(f'  Hex: #{r:02X}{g:02X}{b:02X}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b8c9d0e1",
   "metadata": {},
   "source": [
    "---\n",
    "## 3 — Channel split: side-by-side\n",
    "\n",
    "We isolate each channel by zeroing out the others.  \n",
    "For example, the **Red channel view** keeps R as-is and sets G = 0, B = 0."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "c9d0e1f2",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "application/vnd.jupyter.widget-view+json": {
       "model_id": "3606bc2a86ad4a45a37775d8bfdf3d5d",
       "version_major": 2,
       "version_minor": 0
      },
      "image/png": "",
      "text/html": [
       "\n",
       "            <div style=\"display: inline-block;\">\n",
       "                <div class=\"jupyter-widgets widget-label\" style=\"text-align: center;\">\n",
       "                    Figure\n",
       "                </div>\n",
       "                <img src='data:image/png;base64,' width=1980.0/>\n",
       "            </div>\n",
       "        "
      ],
      "text/plain": [
       "Canvas(toolbar=Toolbar(toolitems=[('Home', 'Reset original view', 'home', 'home'), ('Back', 'Back to previous …"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Channel averages:  R=70.6  G=104.3  B=133.6  A=255.0\n"
     ]
    }
   ],
   "source": [
    "R, G, B, A = arr[:,:,0], arr[:,:,1], arr[:,:,2], arr[:,:,3]\n",
    "\n",
    "# Coloured channel images (each channel shown in its own colour)\n",
    "ch_red   = np.stack([R, np.zeros_like(R), np.zeros_like(R)], axis=2).astype(np.uint8)\n",
    "ch_green = np.stack([np.zeros_like(G), G, np.zeros_like(G)], axis=2).astype(np.uint8)\n",
    "ch_blue  = np.stack([np.zeros_like(B), np.zeros_like(B), B], axis=2).astype(np.uint8)\n",
    "ch_alpha = np.stack([A, A, A], axis=2).astype(np.uint8)  # grayscale\n",
    "\n",
    "fig, axes = plt.subplots(1, 5, figsize=(18, 4))\n",
    "fig.patch.set_facecolor('#f8f8f6')\n",
    "\n",
    "panels = [\n",
    "    (arr3,       'Original',       None),\n",
    "    (ch_red,     'Red channel',    '#c0392b'),\n",
    "    (ch_green,   'Green channel',  '#27ae60'),\n",
    "    (ch_blue,    'Blue channel',   '#2980b9'),\n",
    "    (ch_alpha,   'Alpha channel',  '#7f8c8d'),\n",
    "]\n",
    "\n",
    "for ax, (img_data, title, color) in zip(axes, panels):\n",
    "    ax.imshow(img_data)\n",
    "    ax.set_title(title, color=color if color else '#2c2c2a', fontweight='500')\n",
    "    ax.axis('off')\n",
    "    if color:\n",
    "        for spine in ax.spines.values():\n",
    "            spine.set_edgecolor(color)\n",
    "            spine.set_linewidth(2)\n",
    "            spine.set_visible(True)\n",
    "\n",
    "fig.suptitle('RGB(A) channel decomposition', fontsize=13, fontweight='500', y=1.02)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "print(f'\\nChannel averages:  R={R.mean():.1f}  G={G.mean():.1f}  B={B.mean():.1f}  A={A.mean():.1f}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d0e1f2a3",
   "metadata": {},
   "source": [
    "---\n",
    "## 4 — Greyscale channel views\n",
    "\n",
    "Each channel shown as a **greyscale heatmap** — brighter = higher value.  \n",
    "This makes it easier to see *where* each colour is intense in the image."
   ]
  },
  {
   "cell_type": "code",
